# Application
APP_NAME=AutoPrep AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Security & JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_USER=autoprep
POSTGRES_PASSWORD=autoprep_dev_password
POSTGRES_DB=autoprep_ai
DATABASE_URL=postgresql+asyncpg://autoprep:autoprep_dev_password@db:5432/autoprep_ai

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=autoprep-datasets
MINIO_SECURE=false

# Redis
REDIS_URL=redis://redis:6379/0

# MVP Limits & Retention (SAD Section 1)
MAX_UPLOAD_MB=100
MAX_ROW_COUNT=500000
RETENTION_DAYS=90
SOFT_DELETE_GRACE_DAYS=7

# AI Provider (Gemini API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
